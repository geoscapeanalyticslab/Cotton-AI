# Google OAuth 2.0 Client ID (GCP Console → APIs & Services → Credentials).
# Application type must be "Web application", and the dashboard's origin
# (for example https://geoscapeanalyticslab.github.io) must be listed under
# "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Cloud / Earth Engine project ID that Earth Engine requests are billed to.
VITE_EE_PROJECT=ee-cotton-ai
