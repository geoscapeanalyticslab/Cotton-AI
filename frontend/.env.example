# Google OAuth 2.0 Client ID (GCP Console → APIs & Services → Credentials).
# Application type must be "Web application", and the dashboard's origin
# (for example https://geoscapeanalyticslab.github.io) must be listed under
# "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Cloud project that Earth Engine requests are billed to.
# A project number (for example 1014576056812) works as well as a project ID.
VITE_EE_PROJECT=your-project-id-or-number
