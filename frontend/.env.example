# Google OAuth 2.0 Client ID (from GCP Console → APIs & Services → Credentials)
# Must have Earth Engine API enabled and the GitHub Pages domain as authorized origin
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Cloudflare Worker URL for OAuth token exchange (deploy worker/ first)
VITE_EE_AUTH_WORKER=https://cotton-ai-ee-auth.your-subdomain.workers.dev
